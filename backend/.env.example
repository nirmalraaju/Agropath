# AgroPath Backend Environment Variables

# ===================================================
# 1. Google Gemini AI API Configuration
# Get your API key at: https://aistudio.google.com/
# ===================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Multimodal Embeddings (gemini-embedding-2)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# ===================================================
# 2. OpenWeatherMap API Configuration
# Get your free API key at: https://openweathermap.org/api
# ===================================================
WEATHER_API_KEY=your_openweather_api_key_here
WEATHER_DEFAULT_CITY=Chennai
WEATHER_UNITS=metric

# ===================================================
# 3. Local MongoDB Database Configuration
# ===================================================
MONGODB_URI=mongodb://localhost:27017/agropath
MONGODB_DB_NAME=agropath

# ===================================================
# 4. Security & JWT Authentication
# ===================================================
SECRET_KEY=agropath-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================================================
# 5. Application Settings
# ===================================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
